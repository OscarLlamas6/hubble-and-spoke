# =============================================================================
# versions.env — ÚNICA fuente de verdad de versiones del laboratorio
# -----------------------------------------------------------------------------
# Nada en este repo usa "latest". Si quieres actualizar algo, cámbialo AQUÍ,
# ejecuta `task down && task up` y valida con `task test`.
# Formato KEY=VALUE puro: lo leen tanto bash (source) como Task (dotenv).
# Matriz de compatibilidad y porqués: docs/prerequisites.md
# =============================================================================

# --- Herramientas CLI (se descargan en ./.bin, no tocan tu sistema) ----------
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.35.8
HELM_VERSION=v3.22.1
SUBCTL_VERSION=v0.24.3
CROSSPLANE_CLI_VERSION=v2.4.1

# --- Kubernetes (imagen de nodo de kind, fijada por digest) ------------------
# 1.35 está dentro del rango soportado por Envoy Gateway v1.9 (1.33–1.36).
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0

# --- Componentes dentro de los clústeres -------------------------------------
SUBMARINER_VERSION=0.24.3
CROSSPLANE_VERSION=2.4.4
ENVOY_GATEWAY_VERSION=v1.9.4

# Los paquetes de Crossplane (provider y functions) se fijan en sus manifiestos:
#   crossplane/provider-kubernetes.yaml  y  crossplane/functions.yaml
